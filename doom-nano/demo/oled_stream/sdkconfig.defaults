CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Measured numbers are taken at 240 MHz with -O2 (IDF defaults are 160 MHz and -Og).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# The link carries only binary demo packets, so the console is off (it would share UART0).
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_DEMO_TRANSPORT_UART=y
CONFIG_DEMO_UART_BAUD=2000000
